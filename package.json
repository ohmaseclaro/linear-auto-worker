{
  "name": "linear-auto-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "tsc && node --test \"dist/**/*.test.js\" && npm run smoke",
    "smoke": "tsx scripts/boot-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"dist/**/*.test.js\"",
    "build": "tsc",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.1",
    "@linear/sdk": "93.0.1",
    "@ngrok/ngrok": "1.7.0",
    "better-sqlite3": "13.0.3",
    "execa": "10.0.1",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9",
    "@types/node": "^22",
    "pino-pretty": "^13",
    "tsx": "4.23.13",
    "typescript": "~5.9"
  }
}
