{
  "name": "linear-auto-worker",
  "version": "0.1.0",
  "description": "A local daemon that turns Linear issues assigned to your bot into draft pull requests.",
  "license": "MIT",
  "author": "Augusto Claro (https://github.com/ohmaseclaro)",
  "homepage": "https://github.com/ohmaseclaro/linear-auto-worker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohmaseclaro/linear-auto-worker.git"
  },
  "bugs": {
    "url": "https://github.com/ohmaseclaro/linear-auto-worker/issues"
  },
  "keywords": [
    "linear",
    "linear-app",
    "claude",
    "claude-code",
    "agent",
    "automation",
    "webhook",
    "ngrok",
    "pull-request",
    "daemon",
    "cli"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "law": "dist/src/cli/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "npm run clean && tsc && npm run assets && node --test \"dist/**/*.test.js\" && npm run smoke",
    "smoke": "tsx scripts/boot-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run assets && node --test \"dist/**/*.test.js\"",
    "build": "npm run clean && tsc && npm run assets",
    "dev": "tsx watch src/index.ts",
    "assets": "node -e \"require('fs').cpSync('src','dist/src',{recursive:true,filter:(f)=>!f.endsWith('.ts')})\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.1",
    "@linear/sdk": "93.0.1",
    "@ngrok/ngrok": "1.7.0",
    "better-sqlite3": "13.0.3",
    "execa": "10.0.1",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9",
    "@types/node": "^22",
    "pino-pretty": "^13",
    "tsx": "4.23.13",
    "typescript": "~5.9"
  }
}
