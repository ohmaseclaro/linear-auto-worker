{
  // erasableSyntaxOnly is load-bearing, not stylistic. The canonical gate (D-13) is
  // `tsc --noEmit && node --test`, and `node --test` runs .ts files through Node's type
  // stripping, which only accepts the erasable subset (no enums, no namespaces, no
  // constructor parameter properties). With this flag `tsc` rejects that syntax at the
  // gate; without it, `node --test` silently refuses to load the test file instead.
  //
  // verbatimModuleSyntax is its companion: it keeps `import type` from becoming a runtime
  // import, which is what type stripping assumes.
  //
  // noUncheckedIndexedAccess and exactOptionalPropertyTypes are deliberately OFF — they
  // add friction across seven parallel branches for no defect this project is exposed to.
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  // 07-03: `rootDir` is "." and `test` joined `include` so that
  // `test/integration/*.test.ts` reaches `dist/` at all. 03-01 already found that a file
  // under a top-level test/ is never compiled and therefore never runs -- a passing gate
  // contributing zero coverage. Node's type stripping cannot run these in place either
  // (T34: it will not resolve a `.js` specifier inside a `.ts` file), so compiling them is
  // the only option. Output is now dist/src/** and dist/test/**; the gate's
  // `dist/**/*.test.js` glob matches both.
  //
  // COVERAGE (07-01). "src" is the whole compile surface, and it is complete:
  // `tsc --listFiles` reaches all seven layers -- domain 10, infra 12, ingress 13,
  // orchestration 11, execution 23, outbound 11, cli 16 files. Tests are colocated
  // (`src/**/*.test.ts`), so there is no separate test/ root to include; a bare "src"
  // also picks up any layer added later, which an explicit per-layer list would silently
  // miss. `scripts/` is deliberately OUT: scripts/probe-gsd-allowlist.ts spawns a real
  // `claude` and costs real money, and its own header names living outside src/ as the
  // mechanism that keeps it away from the `node --test` gate.
  "include": ["src", "test"]
}
